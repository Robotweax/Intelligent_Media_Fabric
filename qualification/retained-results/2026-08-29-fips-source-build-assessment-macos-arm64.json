  "decision": {
    "status": "accepted",
    "primary_candidate_id": "fips-release-v0.4.2",
    "development_candidate_disposition": "research-only for observation/probe feasibility until separately qualified",
    "rationale": [
      "The maintenance release built reproducibly from a clean pinned source tree and passed its full locked test suite on the assessment host.",
      "Its daemon/control boundary supports the intended transparent fips0 integration without adopting an experimental application API.",
      "The development candidate is a broad change set, exposes an experimental native API without reliability semantics, and produced one intermittent native-API test failure."
    ]
  },
  "findings": [
    "Both pinned candidates build with the exact repository-pinned Rust 1.94.1 toolchain and locked dependency graphs.",
    "Both candidates expose read-rich control telemetry but no registered route pinning, route-selection, disjoint-path, or multipath mutation command.",
    "The release candidate established and authenticated a two-node UDP loopback link, reported full MMP measurements, and acknowledged a clean disconnect.",
    "The default configured TUN MTU is 1280 and the reported effective inner IPv6 MTU is 1203 after 77 bytes of FIPS IPv6 overhead.",
    "The development native API is experimental, disabled by default, lacks acknowledgement, retransmission, ordering, and flow-control semantics, and has a platform-contract ambiguity in its documentation."
  ],
  "limitations": [
    "This evidence was collected on macOS ARM64; it does not qualify Linux TUN creation, fips0 packet forwarding, nftables, or gateway behavior.",
    "The loopback smoke did not exercise NAT traversal, relay discovery, wide-area loss, reordering, or route reconvergence.",
    "No FSP application payload was sent, so session_count remained zero.",
    "No SRT media stream, payload-integrity validator, downstream media timing, CPU budget, or failover budget was exercised.",
    "G2 remains in progress until the Linux two-node, TUN, NAT, MTU, and control-observation matrix is retained."
  ]
