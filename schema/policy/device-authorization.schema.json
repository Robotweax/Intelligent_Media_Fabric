{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://robotweax.example/schema/rimf/policy/device-authorization-v1.json",
  "title": "Media Fabric device authorization draft",
  "type": "object",
  "required": [
    "schema_version",
    "policy_id",
    "policy_version",
    "issuer",
    "issued_at",
    "not_before",
    "expires_at",
    "tenant_id",
    "device_id",
    "fips_peer_id",
    "grants"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "policy_id": {"type": "string", "format": "uuid"},
    "policy_version": {"type": "integer", "minimum": 1},
    "issuer": {"type": "string", "minLength": 1},
    "issued_at": {"type": "string", "format": "date-time"},
    "not_before": {"type": "string", "format": "date-time"},
    "expires_at": {"type": "string", "format": "date-time"},
    "tenant_id": {"type": "string", "minLength": 1},
    "device_id": {"type": "string", "minLength": 1},
    "fips_peer_id": {"type": "string", "minLength": 1},
    "grants": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["action", "service_id", "stream_pattern"],
        "properties": {
          "action": {"enum": ["publish", "subscribe", "relay", "observe", "administer"]},
          "service_id": {"type": "string", "minLength": 1},
          "stream_pattern": {"type": "string", "minLength": 1}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
