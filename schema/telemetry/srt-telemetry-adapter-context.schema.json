{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://robotweax.example/schema/rimf/telemetry/srt-telemetry-adapter-context-v1.json",
  "title": "RIMF SRT Telemetry adapter context v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "event_namespace",
    "route_epoch",
    "clock",
    "fabric_identity",
    "source_identifiers_pseudonymous",
    "telemetry_revision"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "event_namespace": {"type": "string", "format": "uuid"},
    "route_epoch": {"type": "integer", "minimum": 0},
    "clock": {
      "$ref": "https://robotweax.example/schema/rimf/telemetry/srt-telemetry-observation-v1.json#/$defs/clock"
    },
    "fabric_identity": {
      "$ref": "https://robotweax.example/schema/rimf/telemetry/srt-telemetry-observation-v1.json#/$defs/fabricIdentity"
    },
    "source_identifiers_pseudonymous": {"const": true},
    "telemetry_revision": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "route_epoch_transitions": {
      "description": "Optional explicit route-epoch markers within one recording. Each sample takes the epoch of the last transition whose from_monotonic_ns is at or before its sample_monotonic_nano; epochs increase by one.",
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "items": {
        "type": "object",
        "required": ["route_epoch", "from_monotonic_ns"],
        "properties": {
          "route_epoch": {"type": "integer", "minimum": 1},
          "from_monotonic_ns": {"type": "integer", "minimum": 0}
        },
        "additionalProperties": false
      }
    }
  }
}
