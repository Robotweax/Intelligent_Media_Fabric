{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://robotweax.example/schema/rimf/telemetry/route-epoch-v1.json",
  "title": "Media Fabric route epoch event",
  "type": "object",
  "required": [
    "schema_version",
    "route_epoch",
    "observed_at",
    "monotonic_ns",
    "reason",
    "previous_path_id",
    "current_path_id",
    "confidence"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "route_epoch": {"type": "integer", "minimum": 1},
    "observed_at": {"type": "string", "format": "date-time"},
    "monotonic_ns": {"type": "integer", "minimum": 0},
    "reason": {
      "enum": ["initial", "link-change", "relay-change", "policy-change", "unknown"]
    },
    "previous_path_id": {"type": ["string", "null"]},
    "current_path_id": {"type": ["string", "null"]},
    "confidence": {"type": "number", "minimum": 0, "maximum": 1},
    "evidence_event_ids": {
      "type": "array",
      "items": {"type": "string", "format": "uuid"},
      "uniqueItems": true
    }
  },
  "additionalProperties": false
}
