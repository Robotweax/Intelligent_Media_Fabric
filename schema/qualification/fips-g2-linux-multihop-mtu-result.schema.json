{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://robotweax.example/schema/rimf/qualification/fips-g2-linux-multihop-mtu-result-v1.json",
  "title": "RIMF FIPS G2 Linux heterogeneous multihop-MTU qualification result",
  "type": "object",
  "required": [
    "schema_version",
    "evidence_type",
    "run_id",
    "status",
    "classification",
    "gate_ids",
    "started_at",
    "finished_at",
    "provenance",
    "platform",
    "topology",
    "observations",
    "cleanup",
    "limitations"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "evidence_type": {"const": "fips-g2-linux-multihop-mtu"},
    "run_id": {"type": "string", "format": "uuid"},
    "status": {"const": "passed"},
    "classification": {"const": "experiment"},
    "gate_ids": {"const": ["G2"]},
    "started_at": {"type": "string", "format": "date-time"},
    "finished_at": {"type": "string", "format": "date-time"},
    "provenance": {
      "$ref": "fips-g2-linux-direct-result.schema.json#/properties/provenance"
    },
    "platform": {
      "$ref": "fips-g2-linux-direct-result.schema.json#/properties/platform"
    },
    "topology": {
      "type": "object",
      "required": [
        "node_count",
        "namespace_count",
        "authenticated_link_count",
        "isolation",
        "underlay",
        "path_role",
        "public_discovery",
        "nostr_relay",
        "tun_name",
        "configured_tun_mtu_per_node",
        "configured_udp_mtu_per_node",
        "bottleneck_node"
      ],
      "properties": {
        "node_count": {"const": 3},
        "namespace_count": {"const": 3},
        "authenticated_link_count": {"const": 2},
        "isolation": {"const": "linux-network-namespaces"},
        "underlay": {"const": "two-segment-line-ipv4-udp"},
        "path_role": {"const": "managed-fips-transit"},
        "public_discovery": {"const": false},
        "nostr_relay": {"const": false},
        "tun_name": {"const": "fips0"},
        "configured_tun_mtu_per_node": {"const": [1280, 1280, 1280]},
        "configured_udp_mtu_per_node": {"const": [1280, 1000, 1280]},
        "bottleneck_node": {"const": "r"}
      },
      "additionalProperties": false
    },
    "observations": {
      "type": "object",
      "required": [
        "underlay_exclusion",
        "line_topology",
        "identity_resolution",
        "nodes",
        "mmp",
        "icmpv6",
        "path_mtu",
        "payload_identity",
        "transit_forwarding",
        "disconnect"
      ],
      "properties": {
        "underlay_exclusion": {
          "$ref": "fips-g2-linux-managed-transit-result.schema.json#/properties/observations/properties/underlay_exclusion"
        },
        "line_topology": {
          "$ref": "fips-g2-linux-managed-transit-result.schema.json#/properties/observations/properties/line_topology"
        },
        "identity_resolution": {
          "$ref": "fips-g2-linux-managed-transit-result.schema.json#/properties/observations/properties/identity_resolution"
        },
        "nodes": {
          "type": "array",
          "prefixItems": [
            {"$ref": "#/$defs/endpointA"},
            {"$ref": "#/$defs/transitR"},
            {"$ref": "#/$defs/endpointB"}
          ],
          "items": false
        },
        "mmp": {
          "$ref": "fips-g2-linux-managed-transit-result.schema.json#/properties/observations/properties/mmp"
        },
        "icmpv6": {
          "type": "object",
          "required": [
            "path",
            "small_payload_bytes",
            "effective_mtu_boundary_payload_bytes",
            "passed"
          ],
          "properties": {
            "path": {"const": "endpoint-a-via-managed-transit-r-to-endpoint-b"},
            "small_payload_bytes": {"const": 32},
            "effective_mtu_boundary_payload_bytes": {"const": 875},
            "passed": {"const": true}
          },
          "additionalProperties": false
        },
        "path_mtu": {
          "type": "object",
          "required": [
            "endpoint_effective_ipv6_mtu",
            "transit_transport_mtu",
            "learned_transport_path_mtu",
            "endpoint_session_path_mtus",
            "effective_ipv6_path_mtu",
            "boundary_icmp_payload_bytes",
            "above_boundary_icmp_payload_bytes",
            "above_boundary_ipv6_packet_bytes",
            "echo_reply_received",
            "icmpv6_type",
            "icmpv6_code",
            "reported_mtu",
            "post_ptb_boundary_probe_passed"
          ],
          "properties": {
            "endpoint_effective_ipv6_mtu": {"const": 1203},
            "transit_transport_mtu": {"const": 1000},
            "learned_transport_path_mtu": {"const": 1000},
            "endpoint_session_path_mtus": {"const": [1000, 1000]},
            "effective_ipv6_path_mtu": {"const": 923},
            "boundary_icmp_payload_bytes": {"const": 875},
            "above_boundary_icmp_payload_bytes": {"const": 876},
            "above_boundary_ipv6_packet_bytes": {"const": 924},
            "echo_reply_received": {"const": false},
            "icmpv6_type": {"const": 2},
            "icmpv6_code": {"const": 0},
            "reported_mtu": {"const": 923},
            "post_ptb_boundary_probe_passed": {"const": true}
          },
          "additionalProperties": false
        },
        "payload_identity": {
          "type": "object",
          "required": ["protocol", "records", "all_exact_echo"],
          "properties": {
            "protocol": {"const": "udp-over-ipv6-over-fips0-multihop"},
            "records": {
              "type": "array",
              "prefixItems": [
                {"allOf": [
                  {"$ref": "fips-g2-linux-direct-result.schema.json#/$defs/payloadRecord"},
                  {"properties": {"bytes": {"const": 1}}}
                ]},
                {"allOf": [
                  {"$ref": "fips-g2-linux-direct-result.schema.json#/$defs/payloadRecord"},
                  {"properties": {"bytes": {"const": 512}}}
                ]},
                {"allOf": [
                  {"$ref": "fips-g2-linux-direct-result.schema.json#/$defs/payloadRecord"},
                  {"properties": {"bytes": {"const": 875}}}
                ]}
              ],
              "items": false
            },
            "all_exact_echo": {"const": true}
          },
          "additionalProperties": false
        },
        "transit_forwarding": {
          "$ref": "fips-g2-linux-managed-transit-result.schema.json#/properties/observations/properties/transit_forwarding"
        },
        "disconnect": {
          "$ref": "fips-g2-linux-managed-transit-result.schema.json#/properties/observations/properties/disconnect"
        }
      },
      "additionalProperties": false
    },
    "cleanup": {
      "$ref": "fips-g2-linux-direct-result.schema.json#/properties/cleanup"
    },
    "limitations": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1}
    }
  },
  "$defs": {
    "endpointA": {
      "type": "object",
      "required": ["node", "role", "tun_state", "tun_name", "kernel_tun_mtu", "effective_ipv6_mtu"],
      "properties": {
        "node": {"const": "a"},
        "role": {"const": "endpoint"},
        "tun_state": {"const": "active"},
        "tun_name": {"const": "fips0"},
        "kernel_tun_mtu": {"const": 1280},
        "effective_ipv6_mtu": {"const": 1203}
      },
      "additionalProperties": false
    },
    "transitR": {
      "type": "object",
      "required": ["node", "role", "tun_state", "tun_name", "kernel_tun_mtu", "effective_ipv6_mtu"],
      "properties": {
        "node": {"const": "r"},
        "role": {"const": "managed-transit"},
        "tun_state": {"const": "active"},
        "tun_name": {"const": "fips0"},
        "kernel_tun_mtu": {"const": 1280},
        "effective_ipv6_mtu": {"const": 923}
      },
      "additionalProperties": false
    },
    "endpointB": {
      "type": "object",
      "required": ["node", "role", "tun_state", "tun_name", "kernel_tun_mtu", "effective_ipv6_mtu"],
      "properties": {
        "node": {"const": "b"},
        "role": {"const": "endpoint"},
        "tun_state": {"const": "active"},
        "tun_name": {"const": "fips0"},
        "kernel_tun_mtu": {"const": 1280},
        "effective_ipv6_mtu": {"const": 1203}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
