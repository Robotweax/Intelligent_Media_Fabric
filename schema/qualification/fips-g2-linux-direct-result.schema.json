{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://robotweax.example/schema/rimf/qualification/fips-g2-linux-direct-result-v2.json",
  "title": "RIMF FIPS G2 Linux direct qualification result v1/v2",
  "type": "object",
  "required": [
    "schema_version",
    "evidence_type",
    "run_id",
    "status",
    "classification",
    "gate_ids",
    "started_at",
    "finished_at",
    "provenance",
    "platform",
    "topology",
    "observations",
    "cleanup",
    "limitations"
  ],
  "properties": {
    "schema_version": {"enum": [1, 2]},
    "evidence_type": {"const": "fips-g2-linux-direct"},
    "run_id": {"type": "string", "format": "uuid"},
    "status": {"const": "passed"},
    "classification": {"const": "experiment"},
    "gate_ids": {"const": ["G2"]},
    "started_at": {"type": "string", "format": "date-time"},
    "finished_at": {"type": "string", "format": "date-time"},
    "provenance": {
      "type": "object",
      "required": [
        "project_revision",
        "fips_repository",
        "fips_commit",
        "fips_source_tree_state",
        "cargo_lock_sha256",
        "rust_toolchain_sha256",
        "fips_binary_sha256",
        "fipsctl_binary_sha256",
        "reported_version"
      ],
      "properties": {
        "project_revision": {"$ref": "#/$defs/commit"},
        "fips_repository": {"const": "https://github.com/jmcorgan/fips.git"},
        "fips_commit": {"$ref": "#/$defs/commit"},
        "fips_source_tree_state": {"const": "clean"},
        "cargo_lock_sha256": {"$ref": "#/$defs/sha256"},
        "rust_toolchain_sha256": {"$ref": "#/$defs/sha256"},
        "fips_binary_sha256": {"$ref": "#/$defs/sha256"},
        "fipsctl_binary_sha256": {"$ref": "#/$defs/sha256"},
        "reported_version": {"type": "string"}
      },
      "additionalProperties": false
    },
    "platform": {
      "type": "object",
      "required": ["system", "release", "machine", "python"],
      "properties": {
        "system": {"const": "Linux"},
        "release": {"type": "string"},
        "machine": {"type": "string"},
        "python": {"type": "string"}
      },
      "additionalProperties": false
    },
    "topology": {
      "type": "object",
      "required": [
        "node_count",
        "isolation",
        "underlay",
        "tun_name",
        "configured_tun_mtu",
        "configured_udp_mtu"
      ],
      "properties": {
        "node_count": {"const": 2},
        "isolation": {"const": "linux-network-namespaces"},
        "underlay": {"const": "direct-veth-ipv4-udp"},
        "tun_name": {"const": "fips0"},
        "configured_tun_mtu": {"const": 1280},
        "configured_udp_mtu": {"const": 1280}
      },
      "additionalProperties": false
    },
    "observations": {
      "type": "object",
      "required": [
        "nodes",
        "connection",
        "mmp",
        "icmpv6",
        "payload_identity",
        "fsp_session_counts",
        "disconnect"
      ],
      "properties": {
        "nodes": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": {"$ref": "#/$defs/node"}
        },
        "connection": {
          "type": "object",
          "required": [
            "control_acknowledged",
            "authenticated_peers_per_node",
            "links_per_node",
            "estimated_mesh_size",
            "transport"
          ],
          "properties": {
            "control_acknowledged": {"const": true},
            "authenticated_peers_per_node": {"const": 1},
            "links_per_node": {"const": 1},
            "estimated_mesh_size": {"const": 2},
            "transport": {"const": "udp"}
          },
          "additionalProperties": false
        },
        "mmp": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": {"$ref": "#/$defs/mmp"}
        },
        "icmpv6": {
          "type": "object",
          "required": [
            "small_payload_bytes",
            "effective_mtu_boundary_payload_bytes",
            "echo_requests_per_size",
            "passed"
          ],
          "properties": {
            "small_payload_bytes": {"const": 32},
            "effective_mtu_boundary_payload_bytes": {"const": 1155},
            "echo_requests_per_size": {"const": 2},
            "passed": {"const": true}
          },
          "additionalProperties": false
        },
        "above_effective_mtu": {
          "type": "object",
          "required": [
            "effective_ipv6_mtu",
            "boundary_icmp_payload_bytes",
            "above_boundary_icmp_payload_bytes",
            "above_boundary_ipv6_packet_bytes",
            "echo_reply_received",
            "icmpv6_type",
            "icmpv6_code",
            "reported_mtu",
            "post_ptb_boundary_probe_passed"
          ],
          "properties": {
            "effective_ipv6_mtu": {"const": 1203},
            "boundary_icmp_payload_bytes": {"const": 1155},
            "above_boundary_icmp_payload_bytes": {"const": 1156},
            "above_boundary_ipv6_packet_bytes": {"const": 1204},
            "echo_reply_received": {"const": false},
            "icmpv6_type": {"const": 2},
            "icmpv6_code": {"const": 0},
            "reported_mtu": {"const": 1203},
            "post_ptb_boundary_probe_passed": {"const": true}
          },
          "additionalProperties": false
        },
        "payload_identity": {
          "type": "object",
          "required": ["protocol", "records", "all_exact_echo"],
          "properties": {
            "protocol": {"const": "udp-over-ipv6-over-fips0"},
            "records": {
              "type": "array",
              "minItems": 3,
              "maxItems": 3,
              "items": {"$ref": "#/$defs/payloadRecord"}
            },
            "all_exact_echo": {"const": true}
          },
          "additionalProperties": false
        },
        "fsp_session_counts": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": {"type": "integer", "minimum": 1}
        },
        "disconnect": {
          "type": "object",
          "required": ["control_acknowledged", "peers_per_node_after", "links_per_node_after"],
          "properties": {
            "control_acknowledged": {"const": true},
            "peers_per_node_after": {"const": 0},
            "links_per_node_after": {"const": 0}
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "cleanup": {
      "type": "object",
      "required": [
        "daemons_stopped",
        "namespaces_removed",
        "ephemeral_identity_directory_removed"
      ],
      "properties": {
        "daemons_stopped": {"const": true},
        "namespaces_removed": {"const": true},
        "ephemeral_identity_directory_removed": {"const": true}
      },
      "additionalProperties": false
    },
    "limitations": {"type": "array", "minItems": 1, "items": {"type": "string"}}
  },
  "allOf": [
    {
      "if": {
        "properties": {"schema_version": {"const": 2}}
      },
      "then": {
        "properties": {
          "observations": {
            "required": ["above_effective_mtu"]
          }
        }
      }
    }
  ],
  "$defs": {
    "commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "node": {
      "type": "object",
      "required": ["node", "tun_state", "tun_name", "kernel_tun_mtu", "effective_ipv6_mtu"],
      "properties": {
        "node": {"enum": ["a", "b"]},
        "tun_state": {"const": "active"},
        "tun_name": {"const": "fips0"},
        "kernel_tun_mtu": {"const": 1280},
        "effective_ipv6_mtu": {"const": 1203}
      },
      "additionalProperties": false
    },
    "mmp": {
      "type": "object",
      "required": ["node", "mode", "loss_rate", "etx", "srtt_ms_observed"],
      "properties": {
        "node": {"enum": ["a", "b"]},
        "mode": {"const": "full"},
        "loss_rate": {"type": "number", "minimum": 0},
        "etx": {"type": "number", "minimum": 0},
        "srtt_ms_observed": {"const": true}
      },
      "additionalProperties": false
    },
    "payloadRecord": {
      "type": "object",
      "required": ["bytes", "sha256", "exact_echo"],
      "properties": {
        "bytes": {"enum": [1, 1024, 1155]},
        "sha256": {"$ref": "#/$defs/sha256"},
        "exact_echo": {"const": true}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
