{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://robotweax.example/schema/rimf/qualification/fips-g2-linux-loss-mmp-result-v1.json",
  "title": "RIMF FIPS G2 Linux fixed-loss MMP qualification result v1",
  "type": "object",
  "required": [
    "schema_version", "evidence_type", "run_id", "status", "classification", "gate_ids",
    "started_at", "finished_at", "provenance", "platform", "topology", "observations",
    "cleanup", "limitations"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "evidence_type": {"const": "fips-g2-linux-loss-mmp"},
    "run_id": {"type": "string", "format": "uuid"},
    "status": {"const": "passed"},
    "classification": {"const": "experiment"},
    "gate_ids": {"const": ["G2"]},
    "started_at": {"type": "string", "format": "date-time"},
    "finished_at": {"type": "string", "format": "date-time"},
    "provenance": {"$ref": "fips-g2-linux-direct-result.schema.json#/properties/provenance"},
    "platform": {"$ref": "fips-g2-linux-direct-result.schema.json#/properties/platform"},
    "topology": {
      "type": "object",
      "required": [
        "node_count", "namespace_count", "isolation", "underlay", "tun_name",
        "configured_tun_mtu", "configured_udp_mtu", "heartbeat_interval_secs"
      ],
      "properties": {
        "node_count": {"const": 2},
        "namespace_count": {"const": 2},
        "isolation": {"const": "linux-network-namespaces"},
        "underlay": {"const": "direct-veth-ipv4-udp"},
        "tun_name": {"const": "fips0"},
        "configured_tun_mtu": {"const": 1280},
        "configured_udp_mtu": {"const": 1280},
        "heartbeat_interval_secs": {"const": 1}
      },
      "additionalProperties": false
    },
    "observations": {
      "type": "object",
      "required": [
        "nodes", "connection", "baseline_mmp", "loss_injection", "degraded_mmp",
        "impaired_probe", "session_continuity", "recovery_mmp", "recovered_icmpv6",
        "recovered_payload_identity", "disconnect"
      ],
      "properties": {
        "nodes": {
          "type": "array",
          "prefixItems": [
            {"$ref": "#/$defs/nodeA"},
            {"$ref": "#/$defs/nodeB"}
          ],
          "items": false
        },
        "connection": {
          "type": "object",
          "required": [
            "control_acknowledged", "authenticated_peers_per_node", "links_per_node",
            "estimated_mesh_size", "transport"
          ],
          "properties": {
            "control_acknowledged": {"const": true},
            "authenticated_peers_per_node": {"const": 1},
            "links_per_node": {"const": 1},
            "estimated_mesh_size": {"const": 2},
            "transport": {"const": "udp"}
          },
          "additionalProperties": false
        },
        "baseline_mmp": {
          "type": "object",
          "required": ["mode", "loss_rate_per_node", "maximum_loss_rate"],
          "properties": {
            "mode": {"const": "full"},
            "loss_rate_per_node": {"$ref": "#/$defs/baselineLoss"},
            "maximum_loss_rate": {"const": 0.01}
          },
          "additionalProperties": false
        },
        "loss_injection": {
          "type": "object",
          "required": [
            "mechanism", "loss_model", "configured_loss_percent_per_direction",
            "impaired_underlay_directions", "verified_netem_qdiscs"
          ],
          "properties": {
            "mechanism": {"const": "linux-tc-netem"},
            "loss_model": {"const": "independent-random"},
            "configured_loss_percent_per_direction": {"const": 20.0},
            "impaired_underlay_directions": {"const": 2},
            "verified_netem_qdiscs": {"const": 2}
          },
          "additionalProperties": false
        },
        "degraded_mmp": {
          "type": "object",
          "required": [
            "loss_rate_per_node", "smoothed_loss_per_node", "minimum_loss_rate",
            "maximum_loss_rate", "minimum_increase", "convergence_budget_secs",
            "convergence_elapsed_ms"
          ],
          "properties": {
            "loss_rate_per_node": {"$ref": "#/$defs/degradedLoss"},
            "smoothed_loss_per_node": {"$ref": "#/$defs/smoothedLoss"},
            "minimum_loss_rate": {"const": 0.05},
            "maximum_loss_rate": {"const": 0.60},
            "minimum_increase": {"const": 0.04},
            "convergence_budget_secs": {"const": 60},
            "convergence_elapsed_ms": {"type": "integer", "minimum": 1, "maximum": 60000}
          },
          "additionalProperties": false
        },
        "impaired_probe": {
          "type": "object",
          "required": [
            "protocol", "requests", "interval_ms", "observed_loss_percent",
            "minimum_loss_percent", "maximum_loss_percent"
          ],
          "properties": {
            "protocol": {"const": "icmpv6-over-fips0"},
            "requests": {"const": 600},
            "interval_ms": {"const": 20},
            "observed_loss_percent": {"type": "number", "minimum": 10, "maximum": 70},
            "minimum_loss_percent": {"const": 10.0},
            "maximum_loss_percent": {"const": 70.0}
          },
          "additionalProperties": false
        },
        "session_continuity": {
          "type": "object",
          "required": [
            "session_start_unchanged_during_loss", "session_start_unchanged_after_recovery",
            "peer_counts_during_loss", "link_counts_during_loss", "fsp_session_counts_during_loss"
          ],
          "properties": {
            "session_start_unchanged_during_loss": {"const": [true, true]},
            "session_start_unchanged_after_recovery": {"const": [true, true]},
            "peer_counts_during_loss": {"const": [1, 1]},
            "link_counts_during_loss": {"const": [1, 1]},
            "fsp_session_counts_during_loss": {"const": [1, 1]}
          },
          "additionalProperties": false
        },
        "recovery_mmp": {
          "type": "object",
          "required": [
            "netem_removed_per_direction", "loss_rate_per_node", "smoothed_loss_per_node",
            "maximum_loss_rate", "convergence_budget_secs", "convergence_elapsed_ms"
          ],
          "properties": {
            "netem_removed_per_direction": {"const": [true, true]},
            "loss_rate_per_node": {"$ref": "#/$defs/baselineLoss"},
            "smoothed_loss_per_node": {"$ref": "#/$defs/smoothedLoss"},
            "maximum_loss_rate": {"const": 0.01},
            "convergence_budget_secs": {"const": 60},
            "convergence_elapsed_ms": {"type": "integer", "minimum": 1, "maximum": 60000}
          },
          "additionalProperties": false
        },
        "recovered_icmpv6": {
          "type": "object",
          "required": ["effective_mtu_boundary_payload_bytes", "echo_requests", "passed"],
          "properties": {
            "effective_mtu_boundary_payload_bytes": {"const": 1155},
            "echo_requests": {"const": 2},
            "passed": {"const": true}
          },
          "additionalProperties": false
        },
        "recovered_payload_identity": {"$ref": "#/$defs/payloadIdentity"},
        "disconnect": {
          "type": "object",
          "required": [
            "control_acknowledged", "peers_per_node_after", "links_per_node_after",
            "fsp_sessions_per_node_after"
          ],
          "properties": {
            "control_acknowledged": {"const": true},
            "peers_per_node_after": {"const": 0},
            "links_per_node_after": {"const": 0},
            "fsp_sessions_per_node_after": {"const": 0}
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "cleanup": {
      "type": "object",
      "required": [
        "netem_removed", "stimulus_process_stopped", "daemons_stopped", "namespaces_removed",
        "ephemeral_identity_directory_removed"
      ],
      "properties": {
        "netem_removed": {"const": true},
        "stimulus_process_stopped": {"const": true},
        "daemons_stopped": {"const": true},
        "namespaces_removed": {"const": true},
        "ephemeral_identity_directory_removed": {"const": true}
      },
      "additionalProperties": false
    },
    "limitations": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1}
    }
  },
  "additionalProperties": false,
  "$defs": {
    "nodeA": {
      "$ref": "#/$defs/node",
      "properties": {"node": {"const": "a"}}
    },
    "nodeB": {
      "$ref": "#/$defs/node",
      "properties": {"node": {"const": "b"}}
    },
    "node": {
      "type": "object",
      "required": ["node", "tun_state", "tun_name", "kernel_tun_mtu", "effective_ipv6_mtu"],
      "properties": {
        "node": {"type": "string"},
        "tun_state": {"const": "active"},
        "tun_name": {"const": "fips0"},
        "kernel_tun_mtu": {"const": 1280},
        "effective_ipv6_mtu": {"const": 1203}
      },
      "additionalProperties": false
    },
    "baselineLoss": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {"type": "number", "minimum": 0, "maximum": 0.01}
    },
    "degradedLoss": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {"type": "number", "minimum": 0.05, "maximum": 0.60}
    },
    "smoothedLoss": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {"type": ["number", "null"], "minimum": 0, "maximum": 1}
    },
    "payloadIdentity": {
      "type": "object",
      "required": ["protocol", "records", "all_exact_echo"],
      "properties": {
        "protocol": {"const": "udp-over-ipv6-over-fips0"},
        "records": {
          "type": "array",
          "prefixItems": [
            {"$ref": "#/$defs/payload1"},
            {"$ref": "#/$defs/payload1024"},
            {"$ref": "#/$defs/payload1155"}
          ],
          "items": false
        },
        "all_exact_echo": {"const": true}
      },
      "additionalProperties": false
    },
    "payload1": {"$ref": "#/$defs/payloadRecord", "properties": {"bytes": {"const": 1}}},
    "payload1024": {"$ref": "#/$defs/payloadRecord", "properties": {"bytes": {"const": 1024}}},
    "payload1155": {"$ref": "#/$defs/payloadRecord", "properties": {"bytes": {"const": 1155}}},
    "payloadRecord": {
      "type": "object",
      "required": ["bytes", "sha256", "exact_echo"],
      "properties": {
        "bytes": {"type": "integer", "minimum": 1},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "exact_echo": {"const": true}
      },
      "additionalProperties": false
    }
  }
}
