{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://robotweax.example/schema/rimf/qualification/fips-g2-linux-nat-result-v1.json",
  "title": "RIMF FIPS G2 Linux one-sided NAT qualification result",
  "type": "object",
  "required": [
    "schema_version",
    "evidence_type",
    "run_id",
    "status",
    "classification",
    "gate_ids",
    "started_at",
    "finished_at",
    "provenance",
    "platform",
    "topology",
    "observations",
    "cleanup",
    "limitations"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "evidence_type": {"const": "fips-g2-linux-nat"},
    "run_id": {"type": "string", "format": "uuid"},
    "status": {"const": "passed"},
    "classification": {"const": "experiment"},
    "gate_ids": {"const": ["G2"]},
    "started_at": {"type": "string", "format": "date-time"},
    "finished_at": {"type": "string", "format": "date-time"},
    "provenance": {
      "$ref": "fips-g2-linux-direct-result.schema.json#/properties/provenance"
    },
    "platform": {
      "$ref": "fips-g2-linux-direct-result.schema.json#/properties/platform"
    },
    "topology": {
      "type": "object",
      "required": [
        "node_count",
        "namespace_count",
        "isolation",
        "underlay",
        "nat",
        "tun_name",
        "configured_tun_mtu",
        "configured_udp_mtu"
      ],
      "properties": {
        "node_count": {"const": 2},
        "namespace_count": {"const": 3},
        "isolation": {"const": "linux-network-namespaces"},
        "underlay": {"const": "routed-two-segment-ipv4-udp"},
        "nat": {"const": "one-sided-snat"},
        "tun_name": {"const": "fips0"},
        "configured_tun_mtu": {"const": 1280},
        "configured_udp_mtu": {"const": 1280}
      },
      "additionalProperties": false
    },
    "observations": {
      "type": "object",
      "required": [
        "directional_reachability",
        "nat",
        "nodes",
        "connection",
        "mmp",
        "icmpv6",
        "payload_identity",
        "fsp_session_counts",
        "disconnect"
      ],
      "properties": {
        "directional_reachability": {
          "type": "object",
          "required": [
            "node_a_to_node_b_new_flow_blocked",
            "node_b_to_node_a_new_flow_allowed",
            "stateful_return_path_only"
          ],
          "properties": {
            "node_a_to_node_b_new_flow_blocked": {"const": true},
            "node_b_to_node_a_new_flow_allowed": {"const": true},
            "stateful_return_path_only": {"const": true}
          },
          "additionalProperties": false
        },
        "nat": {
          "type": "object",
          "required": [
            "mode",
            "private_initiator",
            "public_node_observed_translated_source",
            "private_source_address_not_retained"
          ],
          "properties": {
            "mode": {"const": "one-sided-snat"},
            "private_initiator": {"const": "node-b"},
            "public_node_observed_translated_source": {"const": true},
            "private_source_address_not_retained": {"const": true}
          },
          "additionalProperties": false
        },
        "nodes": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": {
            "$ref": "fips-g2-linux-direct-result.schema.json#/$defs/node"
          }
        },
        "connection": {
          "$ref": "fips-g2-linux-direct-result.schema.json#/properties/observations/properties/connection"
        },
        "mmp": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": {
            "$ref": "fips-g2-linux-direct-result.schema.json#/$defs/mmp"
          }
        },
        "icmpv6": {
          "$ref": "fips-g2-linux-direct-result.schema.json#/properties/observations/properties/icmpv6"
        },
        "payload_identity": {
          "$ref": "fips-g2-linux-direct-result.schema.json#/properties/observations/properties/payload_identity"
        },
        "fsp_session_counts": {
          "$ref": "fips-g2-linux-direct-result.schema.json#/properties/observations/properties/fsp_session_counts"
        },
        "disconnect": {
          "$ref": "fips-g2-linux-direct-result.schema.json#/properties/observations/properties/disconnect"
        }
      },
      "additionalProperties": false
    },
    "cleanup": {
      "$ref": "fips-g2-linux-direct-result.schema.json#/properties/cleanup"
    },
    "limitations": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1}
    }
  },
  "additionalProperties": false
}
